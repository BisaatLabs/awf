# Supabase + Cloudinary environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and will never be committed.

# ── Supabase ────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API

# Your project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER expose this to the browser or commit it
# Used only in server-side scripts (e.g. scripts/seed-supabase.ts)
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ──────────────────────────────────────────────────────────────
# Only the cloud name is needed client-side — never put your API secret here

# Your Cloudinary cloud name (safe to expose to the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# API Key and Secret — SERVER-SIDE ONLY (used only in seed script)
# Find these in: Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
